# Copy to .env and edit for local development.
# Never commit real values — .env is gitignored.
# In production these are sourced from the platform secret manager.

# Application
APP_ENV=dev
LOG_LEVEL=info

# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_GRACE=15s

# Postgres (leave POSTGRES_URL empty to run with the in-memory fallback)
POSTGRES_URL=postgres://zoo:zoo@postgres:5432/zoo?sslmode=disable
POSTGRES_USER=zoo
POSTGRES_PASSWORD=zoo
POSTGRES_DB=zoo
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m

# Solver: currently only "greedy" is implemented.
SOLVER=greedy
